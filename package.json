    "groq-sdk": "^1.5.0",
    "openai": "^4.67.3",
    "three": "^0.170.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.0.0"
  }
}
