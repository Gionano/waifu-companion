# Copy file ini jadi .env, lalu isi dengan key 9inference kamu.
# Satu key dipakai untuk semua model (kimi-k3 & deepseek-v4-flash).
NINEINFERENCE_API_KEY=your_9inference_key_here

# Groq — dipakai untuk STT (Whisper). Ambil di https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Fish Audio — dipakai untuk TTS (suara waifu). Ambil di https://fish.audio (API keys).
FISH_API_KEY=your_fish_key_here
